# WhatsJet configuration.
# Copy this file to .env (php install.php does that), then fill in the
# website address and database login. Do not commit .env.

APP_NAME=WhatsJet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL or MariaDB. Create the empty database before running install.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsjet
DB_USERNAME=whatsjet
DB_PASSWORD=

BROADCAST_DRIVER=null
CACHE_STORE=file
FILESYSTEM_DRIVER=public-media-storage
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# predis is installed by Composer. Use phpredis only if that PHP extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# First run writes mail to the log. Switch to smtp when you have a mailbox.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set true only when the site is served over HTTPS.
FORCE_HTTPS=false

# Leave false. true is only for a public demo server.
IS_DEMO_MODE=false

# Optional. The app starts without these. Add them later from the admin screens
# or here. WhatsApp Cloud API keys are stored in the admin panel, not here.
OPENAI_API_KEY=
MICROSOFT_TRANSLATE_API_KEY=
